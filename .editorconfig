root = true

# Match the existing source style. Do not reformat C++ fixture strings: exact
# source ranges and diagnostic locations are intentional compiler-test inputs.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{cpp,h,hpp,yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
