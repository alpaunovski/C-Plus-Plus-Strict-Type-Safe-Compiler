# Python bytecode is generated by both normal imports and verification commands.
__pycache__/
*.pyc
# Native plugins, runtimes, examples, bitcode, reports and local verification logs.
/build/
# Clang-compatible default executable output when -o is omitted.
/a.out
# The pinned LLVM archive and extracted developer distribution are local tooling,
# not project source. Keep them across make clean, but never add them to Git.
/.strictcpp/
# Local environments, credentials, editor backups and macOS metadata are not
# required to build from a checkout. An intentional example environment can ship.
.venv/
.env
.env.*
!.env.example
.DS_Store
*~
# Keep ad-hoc compiler outputs out of source even when built outside build/.
*.o
*.a
*.so
*.dylib
*.bc
*.ll
